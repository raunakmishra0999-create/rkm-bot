import discord
from discord.ext import commands
import os
import json
from datetime import datetime

# ============================================
# BOT SETUP
# ============================================
TOKEN = os.environ.get("DISCORD_TOKEN")

if not TOKEN:
    print("❌ ERROR: DISCORD_TOKEN not found in environment variables!")
    exit(1)

intents = discord.Intents.default()
intents.message_content = True
intents.members = True

bot = commands.Bot(command_prefix="!", intents=intents)

print("✅ Bot is starting...")

# ============================================
# ON READY EVENT
# ============================================
@bot.event
async def on_ready():
    print(f"✅ Bot is online!")
    print(f"✅ Logged in as: {bot.user.name}")
    print(f"✅ Bot ID: {bot.user.id}")
    
    # Set bot status
    await bot.change_presence(activity=discord.Game(name="!rkmhelp"))

# ============================================
# PING COMMAND (Test purpose)
# ============================================
@bot.command(name="ping")
async def ping(ctx):
    """Check if bot is alive"""
    await ctx.send(f"🏓 Pong! Latency: {round(bot.latency * 1000)}ms")

# ============================================
# HELP COMMAND
# ============================================
@bot.command(name="rkmhelp")
async def rkmhelp(ctx):
    """Show all commands"""
    embed = discord.Embed(
        title="🤖 RKM Discord Bot - Commands",
        description="X TOURNEYS Official Bot",
        color=discord.Color.gold()
    )
    embed.add_field(name="!ping", value="Check bot latency", inline=False)
    embed.add_field(name="!hello", value="Bot says hello", inline=False)
    embed.add_field(name="!serverinfo", value="Get server information", inline=False)
    embed.set_footer(text="X TOURNEYS - Tournament Management Bot")
    await ctx.send(embed=embed)

# ============================================
# HELLO COMMAND
# ============================================
@bot.command(name="hello")
async def hello(ctx):
    """Bot says hello"""
    await ctx.send(f"Hello {ctx.author.mention}! Welcome to X TOURNEYS! 🎮")

# ============================================
# SERVER INFO COMMAND
# ============================================
@bot.command(name="serverinfo")
async def serverinfo(ctx):
    """Get server information"""
    guild = ctx.guild
    embed = discord.Embed(
        title=f"📊 {guild.name} Information",
        color=discord.Color.blue()
    )
    embed.add_field(name="👑 Owner", value=guild.owner.mention, inline=True)
    embed.add_field(name="👥 Members", value=guild.member_count, inline=True)
    embed.add_field(name="📚 Text Channels", value=len(guild.text_channels), inline=True)
    embed.add_field(name="🎤 Voice Channels", value=len(guild.voice_channels), inline=True)
    embed.add_field(name="🤖 Bot Name", value=bot.user.name, inline=True)
    await ctx.send(embed=embed)

# ============================================
# ERROR HANDLER
# ============================================
@bot.event
async def on_command_error(ctx, error):
    if isinstance(error, commands.CommandNotFound):
        await ctx.send("❌ Command not found. Use `!rkmhelp` to see available commands.")
    else:
        print(f"Error: {error}")
        await ctx.send(f"❌ An error occurred: {str(error)[:50]}...")

# ============================================
# RUN BOT
# ============================================
if __name__ == "__main__":
    print("▶️ Starting bot...")
    try:
        bot.run(TOKEN)
    except Exception as e:
        print(f"❌ Failed to start bot: {e}")
